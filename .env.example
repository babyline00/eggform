# Environment variables for EggForm
# Copy to .env.local (development) or .env.production (production)
# NEVER commit real secrets to git.

# === Core ===
NODE_ENV=development
DATABASE_URL=file:/home/z/my-project/db/custom.db

# === Auth (NextAuth) ===
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=dev-only-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# === Payment (PKR Wallet) ===
# Generate: openssl rand -base64 32
# Must match the secret configured with your payment provider
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-in-production

# === Payment Providers (production only) ===
# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# Easypaisa
EASYPAISA_MERCHANT_ID=
EASYPAISA_PASSWORD=
EASYPAISA_STORE_ID=

# Bank transfer (manual reconciliation)
BANK_ACCOUNT_NUMBER=
BANK_ROUTING_NUMBER=

# === SMS (for OTP) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Or local Pakistani SMS provider
# JAZZ_SMS_API_KEY=
# TELINOR_SMS_API_KEY=

# === Email ===
SENDGRID_API_KEY=
EMAIL_FROM="EggForm <noreply@eggform.pk>"

# === Object Storage (for KYC docs, images) ===
# AWS S3
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Or Cloudflare R2 (S3-compatible)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# === Redis (production) ===
# Used for: session cache, rate limiting (shared across instances),
# BullMQ job queue, socket.io adapter
REDIS_URL=redis://localhost:6379

# === Real-time Service ===
REALTIME_PORT=3001
REALTIME_CORS_ORIGIN=http://localhost:3000

# === Worker Service ===
WORKER_PORT=3002

# === Monitoring (production) ===
SENTRY_DSN=
LOG_LEVEL=info  # error | warn | info | debug

# === Feature Flags ===
PKR_WALLET_ENABLED=true
KYC_REQUIRED_FOR_WITHDRAWAL=true
WITHDRAWAL_MANUAL_APPROVAL=true
MAINTENANCE_MODE=false

# === Rate Limiting (override defaults if needed) ===
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_DEPOSIT_PER_MIN=10
RATE_LIMIT_WITHDRAW_PER_MIN=3
RATE_LIMIT_KYC_UPLOAD_PER_HOUR=3
